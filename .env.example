# Copy this file to .env and fill in real values. Never commit .env
# (already in .gitignore). Every variable below is read by app/config.py;
# nothing here is invented — if a setting isn't listed, the app doesn't
# consume it.

# --- Application -------------------------------------------------------
APP_NAME=Chatbot API
APP_PORT=8000
# debug | info | warning | error | critical
LOG_LEVEL=info

# --- LLM provider --------------------------------------------------------
# "ollama" (local, default) or "openai".
LLM_PROVIDER=ollama
MODEL_NAME=llama3.2:3b

# --- Ollama (used when LLM_PROVIDER=ollama) -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# --- Milestone 44.1 optional sampling configuration -----------------------
# Both unset by default -- when unset, no "options" field is sent to Ollama
# at all (byte-identical to every request before this setting existed).
# OLLAMA_TEMPERATURE: a float (e.g. 0.2) to make generation less random/more
# literal; leave unset to use Ollama's own default for the model.
OLLAMA_TEMPERATURE=
# OLLAMA_SEED: an integer to make an identical prompt's output reproducible
# run-to-run (useful for debugging a specific reported failure); leave
# unset for normal (non-reproducible) sampling.
OLLAMA_SEED=

# --- OpenAI (only required when LLM_PROVIDER=openai) --------------------
OPENAI_API_KEY=

# --- Tavily (used by the web_search tool) --------------------------------
TAVILY_API_KEY=

# --- Milestone 19 observability -------------------------------------------
# true/false. Default off; when on, structured events render as log lines.
TELEMETRY_ENABLED=false

# --- Milestone 23 request bounding ----------------------------------------
# Total wall-clock seconds allowed for one /chat request's agent
# processing (all iterations combined) before it fails gracefully.
REQUEST_TIMEOUT_SECONDS=120

# --- Milestone 42 CORS (frontend) -----------------------------------------
# Comma-separated list of browser origins allowed to call this API
# cross-origin. Default names the local Next.js dev frontend explicitly
# (frontend/, `npm run dev`, port 3000) -- never a wildcard. Add a
# deployed frontend's real origin here; do not widen this to "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Semantic memory (Step 33: fully production-wired, off by default) ---
# Implemented, tested, and safe to enable -- but OFF by default. When
# enabled, requires `pip install -r requirements-embeddings.txt` (not part
# of the core install) or the app will fail to START (loudly, by design).
SEMANTIC_MEMORY_ENABLED=false
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# cpu or cuda
EMBEDDING_DEVICE=cpu
SEMANTIC_MEMORY_MAX_RECORDS_PER_SESSION=200
# Cosine-similarity floor (range [-1.0, 1.0]) a retrieved memory must meet
# to be shown to the model. 0.3 is calibrated against the real embedding
# model (all-MiniLM-L6-v2) -- see app/config.py for the measurement this
# default is based on. Recalibrate if the embedding model ever changes.
SEMANTIC_MEMORY_MIN_SIMILARITY=0.3

# --- Step 36 conversation/session persistence (off by default) -----------
# "memory" (default): process-local, lost on restart -- unchanged behavior.
# "sqlite": conversation + session memory persist to a local SQLite file
# across restarts. Episodic and semantic memory are NOT persisted yet
# regardless of this setting (a later milestone). Any other value fails
# application startup loudly (by design -- never silently falls back).
MEMORY_BACKEND=memory
# Only used when MEMORY_BACKEND=sqlite. Parent directory is created
# automatically if it doesn't exist. Never commit the resulting .db file
# (already in .gitignore).
SQLITE_DB_PATH=./data/conversations.db
