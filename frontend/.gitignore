# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (Milestone 43 E2E suite) -- generated run artifacts
# (traces, screenshots, HTML reports), never source
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template (mirrors the backend's .env.example
# convention: a tracked example with no real values, never the real file).
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
