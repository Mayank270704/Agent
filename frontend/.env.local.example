# Copy this file to .env.local for local development (never commit
# .env.local -- it is already excluded via .gitignore, matching the
# backend's own .env handling).
#
# The ONLY environment variable this frontend reads. Public on purpose
# (NEXT_PUBLIC_ prefix, required by Next.js to expose a variable to the
# browser) -- it is just the backend's address, never a secret. No
# Tavily/Ollama/API key ever belongs here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
